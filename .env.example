# Bắt buộc: token của bot (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=dán_token_vào_đây

# Tuỳ chọn: ID server của bạn -> lệnh slash cập nhật ngay (nên điền khi đang thử nghiệm)
GUILD_ID=

# Tuỳ chọn: ID kênh gửi tin chào mừng (bỏ trống = dùng kênh hệ thống của server)
WELCOME_CHANNEL_ID=

# Tuỳ chọn: ID role tự cấp cho thành viên mới
AUTO_ROLE_ID=
